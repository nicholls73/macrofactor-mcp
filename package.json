{
  "name": "macrofactor-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/dev.mjs",
    "plan": "npm run build && terraform -chdir=infra plan",
    "deploy": "npm run build && terraform -chdir=infra apply",
    "ingest": "node scripts/ingest.mjs",
    "type-check": "tsc --noEmit",
    "test": "npm run build && node --test scripts/*.test.mjs",
    "doc-drift": "node scripts/doc-drift.mjs"
  },
  "dependencies": {
    "agents": "^0.17.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250310.0",
    "esbuild": "0.28.1",
    "miniflare": "4.20260625.0",
    "typescript": "^5.6.0"
  }
}
